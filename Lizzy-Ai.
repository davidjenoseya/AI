
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>My Barbie Princess | Birthday Surprise</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Georgia', serif;
    background: linear-gradient(135deg, #ffe0ef, #ffc1dc, #fff0f7);
    color: #8d2458;
    min-height: 100vh;
    overflow-x: hidden;
}

button, input, textarea {
    font: inherit;
}

button {
    cursor: pointer;
    border: none;
    border-radius: 30px;
    padding: 13px 22px;
    background: linear-gradient(135deg, #ff5da2, #d63384);
    color: white;
    box-shadow: 0 5px 15px #d6338440;
}

button:hover {
    transform: translateY(-2px);
}

.hidden {
    display: none !important;
}

section {
    padding: 35px 16px;
}

h1, h2 {
    text-align: center;
    margin-bottom: 20px;
}

h1 {
    font-size: clamp(30px, 7vw, 52px);
}

h2 {
    font-size: clamp(24px, 5vw, 36px);
}

p {
    line-height: 1.8;
}

.card {
    width: min(92%, 650px);
    margin: 25px auto;
    padding: 28px 20px;
    text-align: center;
    background: #ffffffd9;
    border: 2px solid #ffb5d5;
    border-radius: 25px;
    box-shadow: 0 12px 35px #a52a5b20;
}

input, textarea {
    width: 100%;
    padding: 13px;
    margin: 10px 0;
    border: 1px solid #f4a3c7;
    border-radius: 12px;
    background: #fff8fc;
    color: #8d2458;
}

textarea {
    min-height: 100px;
    resize: vertical;
}

.hero {
    min-height: 90vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 25px;
}

.subtitle {
    font-size: 18px;
    margin: 12px auto;
}

.butterfly {
    font-size: 35px;
    animation: float 3s ease-in-out infinite;
}

@keyframes float {
    0%, 100% { transform: translateY(0) rotate(-8deg); }
    50% { transform: translateY(-15px) rotate(8deg); }
}

#countdown {
    font-size: clamp(25px, 7vw, 42px);
    font-weight: bold;
    margin: 20px 0;
    color: #d63384;
}

.gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    max-width: 950px;
    margin: 25px auto;
}

.memory {
    background: white;
    padding: 10px;
    border-radius: 18px;
    box-shadow: 0 5px 18px #b94b7b25;
}

.memory img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: 12px;
    background: #ffe0ef;
}

.memory p {
    padding: 9px 3px;
    text-align: center;
    font-size: 14px;
}

.cake {
    font-size: 100px;
    cursor: pointer;
    display: inline-block;
    transition: transform .3s;
}

.cake:active {
    transform: scale(.9);
}

.editor {
    max-width: 850px;
}

.editor label {
    display: block;
    text-align: left;
    font-weight: bold;
    margin-top: 15px;
}

#fireworks {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 10;
}

footer {
    text-align: center;
    padding: 30px;
}

@media (min-width: 700px) {
    .gallery {
        grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    section {
        padding: 55px 25px;
    }
}

@media (max-width: 360px) {
    .gallery {
        gap: 8px;
    }

    .card {
        padding: 22px 14px;
    }

    button {
        padding: 12px 16px;
    }
}
</style>
</head>

<body>

<canvas id="fireworks"></canvas>

<!-- LOGIN -->
<section id="loginScreen" class="hero">
    <div class="butterfly">🦋 🦋 🦋</div>
    <h1>Welcome to Your Fairytale</h1>
    <p class="subtitle">A little world made with love, just for you 💗</p>

    <div class="card">
        <h2>Enter Your Secret Password</h2>

        <input type="password" id="password"
               placeholder="Enter password">

        <button onclick="login()">Open My Surprise 💕</button>

        <p id="loginError" style="color:red;margin-top:12px"></p>
    </div>
</section>

<!-- COUNTDOWN -->
<section id="countdownScreen" class="hero hidden">
    <div class="butterfly">🦋</div>
    <h1>Something Magical Is Waiting...</h1>
    <p class="subtitle">
        Your birthday surprise is locked until December 8 💗
    </p>

    <div id="countdown">Loading...</div>

    <p>Every second brings us closer to your special day.</p>
</section>

<!-- ADMIN EDITOR -->
<section id="adminScreen" class="hidden">
    <h1>👑 Royal Admin Dashboard</h1>
    <p style="text-align:center">
        Edit your princess's birthday surprise.
    </p>

    <div class="card editor">
        <label>Opening Letter</label>
        <textarea id="editOpening"></textarea>

        <label>Welcome Heading</label>
        <input id="editHeading">

        <label>First Birthday Wish</label>
        <textarea id="editWish"></textarea>

        <label>Final Love Letter</label>
        <textarea id="editFinal"></textarea>

        <h2 style="margin-top:25px">Memory Gallery 🦋</h2>
        <p>Upload up to 8 photos.</p>

        <div id="photoEditors"></div>

        <button onclick="saveChanges()">Save All Changes 💗</button>
        <button onclick="previewSite()">Preview Website 👀</button>
        <button onclick="logout()" style="background:#777">Logout</button>
    </div>
</section>

<!-- BIRTHDAY WEBSITE -->
<main id="birthdaySite" class="hidden">

    <section class="hero">
        <div class="butterfly">🦋 🌸 🦋</div>
        <h1 id="mainHeading">Welcome to Your 22nd Year</h1>
        <p class="subtitle">
            Happy Birthday to my Barbie Princess! 👑
        </p>
        <p>Today, the whole world celebrates you. 💕</p>
    </section>

    <section>
        <div class="card">
            <h2>💌 A Letter From My Heart</h2>
            <p id="openingText"></p>
        </div>
    </section>

    <section>
        <div class="card">
            <h2>🎂 Let's Cut Your Birthday Cake!</h2>
            <p>Tap the cake to make your birthday wish.</p>
            <div class="cake" onclick="cutCake()">🎂</div>
            <p id="cakeMessage">Make a beautiful wish, princess! 💗</p>
        </div>
    </section>

    <section>
        <h2>📸 Our Beautiful Memories</h2>
        <p style="text-align:center">
            Eight little windows into our beautiful story.
        </p>
        <div class="gallery" id="gallery"></div>
    </section>

    <section>
        <div class="card">
            <h2>🌷 A Special Wish For You</h2>
            <p id="middleWish"></p>
        </div>
    </section>

    <section>
        <div class="card">
            <h2>❤️ My Forever Letter</h2>
            <p id="finalLetter"></p>
        </div>
    </section>

    <section class="hero">
        <div class="butterfly">🦋 🦋 🦋</div>
        <h1>Happy Birthday, My Love!</h1>
        <p class="subtitle">
            May your new year be filled with happiness,
            success, beautiful dreams and endless love.
        </p>
        <h2>Forever Yours ❤️</h2>
        <button onclick="celebrate()">Celebrate Again 🎆</button>
    </section>

</main>

<footer>
    Made with endless love 💗
</footer>

<script>
// PASSWORDS
const ADMIN_PASSWORD = "130793";
const USER_PASSWORD = "2004";

// BIRTHDAY RELEASE DATE - INDIA TIME
const RELEASE_DATE = new Date("2026-12-08T23:59:00+05:30");

const defaultContent = {
    opening: "My love, today is not just another birthday. It is the celebration of the beautiful person who makes my world brighter. I am so lucky to have you in my life. Happy Birthday, my princess! 💗",

    heading: "Welcome to Your 22nd Year",

    wish: "May every dream you carry become reality. May your career grow, your smile never fade, and your heart always find happiness. You deserve all the beautiful things in this world. 🌸",

    final: "My dearest love,\n\nI want to see you achieve everything you dream about. I will always be proud of your efforts, your strength, and the person you are becoming. No matter how difficult life gets, I hope we continue to support each other, grow together, and create beautiful memories.\n\nI don't promise that every day will be perfect, but I promise to keep choosing you, respecting you, and cheering for you. I want to build a beautiful future with you, filled with love, laughter, trust, and happiness.\n\nHappy Birthday, my love. You are my favourite person, my happiness, and my forever. ❤️"
};

let content = loadContent();
let isAdmin = false;
let previewMode = false;
let countdownTimer;

function loadContent() {
    try {
        const saved = localStorage.getItem("birthdayContent");
        return saved ? JSON.parse(saved) : {...defaultContent};
    } catch (e) {
        return {...defaultContent};
    }
}

function login() {
    const password = document.getElementById("password").value;

    if (password === ADMIN_PASSWORD) {
        isAdmin = true;
        show("adminScreen");
        loadEditor();
    } else if (password === USER_PASSWORD) {
        isAdmin = false;

        if (new Date() >= RELEASE_DATE) {
            revealBirthday();
        } else {
            show("countdownScreen");
            startCountdown();
        }
    } else {
        document.getElementById("loginError").textContent =
            "Incorrect password. Please try again.";
    }
}

function show(id) {
    ["loginScreen", "countdownScreen", "adminScreen", "birthdaySite"]
        .forEach(x => document.getElementById(x).classList.add("hidden"));

    document.getElementById(id).classList.remove("hidden");
}

function startCountdown() {
    clearInterval(countdownTimer);

    function update() {
        const difference = RELEASE_DATE - new Date();

        if (difference <= 0) {
            clearInterval(countdownTimer);
            revealBirthday();
            return;
        }

        const days = Math.floor(difference / 86400000);
        const hours = Math.floor(difference % 86400000 / 3600000);
        const minutes = Math.floor(difference % 3600000 / 60000);
        const seconds = Math.floor(difference % 60000 / 1000);

        document.getElementById("countdown").textContent =
            `${days}d ${hours}h ${minutes}m ${seconds}s`;
    }

    update();
    countdownTimer = setInterval(update, 1000);
}

function loadEditor() {
    document.getElementById("editOpening").value = content.opening;
    document.getElementById("editHeading").value = content.heading;
    document.getElementById("editWish").value = content.wish;
    document.getElementById("editFinal").value = content.final;

    const container = document.getElementById("photoEditors");
    container.innerHTML = "";

    for (let i = 0; i < 8; i++) {
        const savedPhoto = localStorage.getItem("birthdayPhoto" + i);

        container.innerHTML += `
            <label>Memory Photo ${i + 1}</label>
            <input type="file" accept="image/*"
                   onchange="uploadPhoto(event, ${i})">
            <p style="font-size:13px">Choose a photo from your device.</p>
        `;
    }
}

function uploadPhoto(event, index) {
    const file = event.target.files[0];
    if (!file) return;

    if (!file.type.startsWith("image/")) {
        alert("Please select an image.");
        return;
    }

    if (file.size > 1.2 * 1024 * 1024) {
        alert("Please choose a photo smaller than 1.2 MB.");
        return;
    }

    const reader = new FileReader();

    reader.onload = function() {
        try {
            localStorage.setItem("birthdayPhoto" + index, reader.result);
            alert("Photo uploaded successfully! 💗");
        } catch (error) {
            alert("Storage is full. Try a smaller photo.");
        }
    };

    reader.readAsDataURL(file);
}

function saveChanges() {
    content = {
        opening: document.getElementById("editOpening").value,
        heading: document.getElementById("editHeading").value,
        wish: document.getElementById("editWish").value,
        final: document.getElementById("editFinal").value
    };

    localStorage.setItem("birthdayContent", JSON.stringify(content));

    alert("Your changes have been saved! 💕");
}

function previewSite() {
    saveChanges();
    previewMode = true;
    revealBirthday();
}

function revealBirthday() {
    show("birthdaySite");

    document.getElementById("mainHeading").textContent = content.heading;
    document.getElementById("openingText").textContent = content.opening;
    document.getElementById("middleWish").textContent = content.wish;
    document.getElementById("finalLetter").textContent = content.final;

    buildGallery();
    celebrate();
}

function buildGallery() {
    const gallery = document.getElementById("gallery");
    gallery.innerHTML = "";

    const quotes = [
        "My favourite smile ❤️",
        "A beautiful memory 🌸",
        "One of my happiest moments 💗",
        "Forever in my heart 🦋",
        "My favourite person 👑",
        "Every moment matters ✨",
        "Our little story 💕",
        "More memories to come 🌷"
    ];

    for (let i = 0; i < 8; i++) {
        const photo = localStorage.getItem("birthdayPhoto" + i);

        const image = photo
            ? `<img src="${photo}" alt="Memory ${i + 1}">`
            : `<div style="aspect-ratio:1;background:#ffe0ef;
                   display:grid;place-items:center;border-radius:12px;
                   font-size:35px">🦋</div>`;

        gallery.innerHTML += `
            <div class="memory">
                ${image}
                <p>${quotes[i]}</p>
            </div>
        `;
    }
}

function cutCake() {
    document.getElementById("cakeMessage").textContent =
        "🎉 Happy Birthday, my princess! May all your dreams come true! ❤️";

    celebrate();
}

function celebrate() {
    const canvas = document.getElementById("fireworks");
    const ctx = canvas.getContext("2d");

    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;

    const particles = [];

    for (let i = 0; i < 130; i++) {
        particles.push({
            x: Math.random() * canvas.width,
            y: Math.random() * canvas.height * 0.65,
            size: Math.random() * 4 + 2,
            speed: Math.random() * 3 + 1,
            angle: Math.random() * Math.PI * 2,
            life: 70
        });
    }

    function animate() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);

        particles.forEach(p => {
            ctx.beginPath();
            ctx.fillStyle =
                ["#ff2d95", "#ffd700", "#ffffff", "#c77dff"]
                [Math.floor(Math.random() * 4)];

            ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
            ctx.fill();

            p.x += Math.cos(p.angle) * p.speed;
            p.y += Math.sin(p.angle) * p.speed;
            p.life--;
        });

        const alive = particles.some(p => p.life > 0);

        if (alive) requestAnimationFrame(animate);
        else ctx.clearRect(0, 0, canvas.width, canvas.height);
    }

    animate();
}

function logout() {
    isAdmin = false;
    previewMode = false;
    clearInterval(countdownTimer);
    document.getElementById("password").value = "";
    show("loginScreen");
}

window.addEventListener("resize", () => {
    const canvas = document.getElementById("fireworks");
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
});
</script>

</body>
</html>
